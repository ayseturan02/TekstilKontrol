PORT=4000
# En az 32 karakterli rastgele anahtar. setup-admin ilk kurulumda otomatik oluşturur.
JWT_SECRET=BURAYA_UZUN_RASTGELE_EN_AZ_32_KARAKTER_ANAHTAR
# İlk hesabı oluşturmak için: npm run setup-admin -- --first-name Ad --last-name Soyad --email admin@firma.com
# Eski tek hesabı yöneticiye dönüştürmek için isteğe bağlı:
# USER_EMAIL=kontrol@firma.com
# USER_PASSWORD_HASH=BCRYPT_HASH
# ADMIN_FIRST_NAME=Ad
# ADMIN_LAST_NAME=Soyad
# USERS_FILE=/kalici/dizin/users.json
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=mail@example.com
SMTP_PASSWORD=uygulama_sifresi
SMTP_FROM=mail@example.com
# RECIPIENTS_FILE=/kalici/dizin/recipients.json
